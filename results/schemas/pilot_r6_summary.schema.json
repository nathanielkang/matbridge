{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaTBridge pilot_r6_summary schema",
  "description": "Output of scripts/run_pilot.py. Captures R6 clause checks across datasets/seeds.",
  "type": "object",
  "required": ["schema", "datasets", "seeds", "pilot_status", "r6_global"],
  "properties": {
    "schema": {"type": "string", "const": "pilot-r6-summary-v1"},
    "datasets": {"type": "array", "items": {"type": "string"}},
    "seeds": {"type": "array", "items": {"type": "integer"}},
    "eta": {"type": "number"},
    "epochs": {"type": "integer"},
    "n_synthetic_cap": {"type": "integer"},
    "wall_clock_sec": {"type": "number"},
    "pilot_status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "note": {"type": "string"},
    "r6_global": {
      "type": "object",
      "required": [
        "clause1_matched_eta_zero_forbidden_diffs",
        "clause2a_median_gain_vs_gaussian_gt0",
        "clause2b_median_gain_vs_vine_gt0",
        "clause4_bridge_lt50pct"
      ],
      "properties": {
        "clause1_matched_eta_zero_forbidden_diffs": {"type": "boolean"},
        "clause2a_median_gain_vs_gaussian_gt0": {"type": "boolean"},
        "clause2b_median_gain_vs_vine_gt0": {"type": "boolean"},
        "clause2c_win_rate_gaussian_ge60": {"type": "boolean"},
        "clause2d_win_rate_vine_ge60": {"type": "boolean"},
        "clause3_causal_linkage": {},
        "clause4_bridge_lt50pct": {"type": "boolean"},
        "global_win_rate_gaussian": {"type": "number"},
        "global_win_rate_vine": {"type": "number"},
        "global_median_gain_vs_gaussian": {"type": "number"},
        "global_median_gain_vs_vine": {"type": "number"},
        "global_bridge_contribution_median": {"type": "number"}
      }
    },
    "dataset_results": {"type": "array"}
  }
}
